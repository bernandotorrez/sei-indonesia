# Used only by the root docker-compose.yml (the "everything in Docker" flow).
# Copy to .env and fill in before `docker compose up --build`.
# This is separate from stock-opname-be/.env and stock-opname-fe/.env, which are for the
# manual npm-based flow instead - see README.md for which one you're using.

JWT_SECRET=change-me-in-production

# Optional - leave blank to disable reCAPTCHA verification, same behavior as the per-app .env
# files. Get a v3 key pair at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=
NUXT_PUBLIC_RECAPTCHA_SITE_KEY=
