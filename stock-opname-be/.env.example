NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_opname
DB_USER=stock_opname
DB_PASS=stock_opname
DB_DIALECT=postgres

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# how often the reconciliation worker polls for pending jobs, in ms
WORKER_POLL_INTERVAL_MS=2000

CORS_ORIGIN=http://localhost:3000

# --- Login security ---
# Per-IP throttle on POST /auth/login (separate from the per-account lockout below).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Per-account lockout: after this many wrong passwords in a row, the account is locked for
# ACCOUNT_LOCKOUT_MINUTES regardless of which IP is attempting.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=3
ACCOUNT_LOCKOUT_MINUTES=15

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin). Leave blank to disable
# verification for local dev/testing - it activates automatically once set.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
