{
  "name": "stock-opname-be",
  "version": "1.0.0",
  "description": "Stock Opname & Async Inventory Reconciliation API",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node jobs/reconciliationWorker.js",
    "worker:dev": "nodemon jobs/reconciliationWorker.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "lint": "eslint . --ignore-pattern 'node_modules/**'",
    "lint:fix": "eslint . --ignore-pattern 'node_modules/**' --fix",
    "pretest": "node scripts/createTestDb.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-bearer-token": "^3.0.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.2",
    "pg": "^8.13.1",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  }
}
